# Copie para .env e ajuste se quiser
POSTGRES_USER=fit
POSTGRES_PASSWORD=fit
POSTGRES_DB=fitness

# URL usada pela API e pelo Alembic (host 5434 -> ver docker-compose)
DATABASE_URL=postgresql+psycopg://fit:fit@localhost:5434/fitness

# Token de acesso a API. Vazio = auth desligada (dev). Em producao gere um forte:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# CORS: "*" libera tudo (dev). Em producao, liste as origens: https://app.exemplo.com,https://...
CORS_ORIGINS=*
