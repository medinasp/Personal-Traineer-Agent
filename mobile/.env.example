# Copie para .env. Use o IP da sua maquina na LAN (nao "localhost"),
# senao o emulador/celular nao acha a API.
# Descubra o IP: `ip addr` (Linux) e procure algo tipo 192.168.x.x
EXPO_PUBLIC_API_URL=http://192.168.0.10:8000/api/v1

# Em producao: aponte pro dominio HTTPS e defina o mesmo token do backend (API_TOKEN).
# EXPO_PUBLIC_API_URL=https://meu-treino.duckdns.org/api/v1
# EXPO_PUBLIC_API_TOKEN=cole-o-mesmo-token-do-backend

# Coach rodando no proprio celular (chama a Groq direto). Use a MESMA chave do
# backend (GROQ_API_KEY). Vai embarcada no app -> nao publique o APK em loja aberta.
# Para o build na nuvem (EAS), a chave NAO fica aqui nem no eas.json (versionado):
# guarde como env var sensivel no EAS (ver instrucoes abaixo neste arquivo).
EXPO_PUBLIC_GROQ_API_KEY=cole-sua-chave-groq-aqui
# Opcionais (tem padrao no codigo):
# Cadeia de modelos (primario,fallback1,fallback2) — todos precisam suportar tool-calling.
# EXPO_PUBLIC_GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# EXPO_PUBLIC_GROQ_WHISPER_MODEL=whisper-large-v3-turbo
