# Copie para .env. Use o IP da sua maquina na LAN (nao "localhost"),
# senao o emulador/celular nao acha a API.
# Descubra o IP: `ip addr` (Linux) e procure algo tipo 192.168.x.x
EXPO_PUBLIC_API_URL=http://192.168.0.10:8000/api/v1

# Em producao: aponte pro dominio HTTPS e defina o mesmo token do backend (API_TOKEN).
# EXPO_PUBLIC_API_URL=https://meu-treino.duckdns.org/api/v1
# EXPO_PUBLIC_API_TOKEN=cole-o-mesmo-token-do-backend
